    "import matplotlib.pyplot as plt\n",
    "from sklearn.cluster import KMeans\n",
    "from sklearn.datasets import make_blobs\n",
    "\n",
    "# Re-generate the same synthetic data for consistency if needed, or use the existing X\n",
    "# X, y = make_blobs(n_samples=200, centers=4, cluster_std=0.60, random_state=0)\n",
    "\n",
    "wcss = []\n",
    "max_k = 10  # Let's test K from 1 to 10\n",
    "\n",
    "for i in range(1, max_k + 1):\n",
    "    kmeans = KMeans(n_clusters=i, init='k-means++', max_iter=300, random_state=0, n_init=10)\n",
    "    kmeans.fit(X)\n",
    "    wcss.append(kmeans.inertia_)  # inertia_ is the WCSS\n",
    "\n",
    "# Plotting the Elbow Method\n",
    "plt.figure(figsize=(10, 6))\n",
    "plt.plot(range(1, max_k + 1), wcss, marker='o', linestyle='--')\n",
    "plt.title('Elbow Method For Optimal K')\n",
    "plt.xlabel('Number of Clusters (K)')\n",
    "plt.ylabel('Within-Cluster Sum of Squares (WCSS)')\n",
    "plt.xticks(range(1, max_k + 1))\n",
    "plt.grid(True)\n",
    "plt.show()"
   ]
